# Copie para .env e preencha os segredos, ou execute make env.
# Variáveis são compartilhadas por GNU Make e Docker Compose.
DATABASE_PASSWORD=
JWT_SECRET=

# Portas locais da infraestrutura (Make deriva os endereços da aplicação).
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
SERVER_PORT=8080

# Banco: DATABASE_URL usa r2dbc; Flyway usa uma URL JDBC separada.
# DATABASE_URL=r2dbc:postgresql://localhost:5432/mydatabase
# FLYWAY_DATABASE_URL=jdbc:postgresql://localhost:5432/mydatabase
DATABASE_POOL_SIZE=10

# Configuração da API.
JWT_ISSUER=template
JWT_ACCESS_TOKEN_TTL=PT15M
CORS_ALLOWED_ORIGINS=
OPENAPI_ENABLED=true
DOCKER_COMPOSE_ENABLED=false

# Fluxo Customer: cache limitado a 5 minutos, retries persistidos e polling da Outbox.
CUSTOMER_CACHE_TTL=PT1M
CUSTOMER_OUTBOX_POLL_MS=500
CUSTOMER_OUTBOX_MAX_ATTEMPTS=10
CUSTOMER_CONSUMER_BACKOFF_MS=1000
